NODE_ENV=development
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:password@localhost:5432/peppol
RUN_MIGRATIONS=true

# Bootstrap du compte administrateur au démarrage.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-with-a-long-password
ADMIN_SESSION_TTL_HOURS=12

# 32 octets sous forme de 64 caractères hexadécimaux.
# Génération: openssl rand -hex 32
ENCRYPTION_SECRET=replace-with-64-hex-characters

# Validation indépendante du provider.
KOSIT_VALIDATOR_URL=[kositURL]
VALIDATE_BEFORE_SEND=true

# Credentials globaux Dokapi (fallback pour les entreprises configurées en global).
DOKAPI_CLIENT_ID=
DOKAPI_CLIENT_SECRET=
DOKAPI_BASE_URL=https://peppol-api.dokapi-stg.io/v1
DOKAPI_TOKEN_URL=https://dev-portal.dokapi.io/api/oauth2/token
DOKAPI_WEBHOOK_SECRET=

# Webhooks sortants clients.
PUBLIC_API_URL=http://localhost:3001
WEBHOOK_WORKER_INTERVAL_MS=30000
WEBHOOK_MAX_ATTEMPTS=8
