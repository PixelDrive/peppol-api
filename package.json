{
    "name": "peppol-hono-api",
    "version": "0.1.0",
    "license": "MIT",
    "private": true,
    "type": "module",
    "main": "dist/index.mjs",
    "scripts": {
        "build": "vite build",
        "check-types": "tsc -p tsconfig.json --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "dev": "tsx watch src/index.ts",
        "format": "prettier --write \"**/*.{ts,md,json,yml,yaml}\"",
        "format:check": "prettier --check \"**/*.{ts,md,json,yml,yaml}\"",
        "lint": "eslint .",
        "start": "node dist/index.mjs",
        "test": "vitest run"
    },
    "dependencies": {
        "@dotenvx/dotenvx": "1.64.0",
        "@hono/node-server": "1.19.14",
        "@orpc/openapi": "1.14.0",
        "@orpc/server": "1.14.0",
        "@orpc/zod": "1.14.0",
        "@pixeldrive/peppol-toolkit": "0.8.2",
        "drizzle-orm": "0.45.2",
        "hono": "4.12.15",
        "pino": "10.3.1",
        "postgres": "3.4.8",
        "zod": "4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "25.6.0",
        "drizzle-kit": "0.31.10",
        "eslint": "10.2.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-only-warn": "1.2.1",
        "eslint-plugin-sonarjs": "4.0.3",
        "eslint-plugin-unicorn": "63.0.0",
        "prettier": "3.8.3",
        "tsx": "4.21.0",
        "typescript": "5.9.3",
        "typescript-eslint": "8.59.1",
        "vite": "8.0.10",
        "vitest": "4.1.5"
    },
    "packageManager": "pnpm@9.0.0",
    "engines": {
        "node": ">=20"
    }
}
